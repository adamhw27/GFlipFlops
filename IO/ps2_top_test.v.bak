module ps2_top_test (
	input wire clk, rst,				// FPGA Clock & Reset signals
	input wire ps2_clk, ps2_dat,	// PS/2 Clock & Data inputs
	output reg [3:0] led
);

reg [3:0] ps2_out;

ps2_interface_mod ps2_mod(.clk(clk), .rst(rst), .ps2_clk(ps2_clk), .ps2_dat(ps2_dat), .key_enc(ps2_out));

always @(*) begin
	led = 4'b0;
	if (en) begin
		led = ps2_out;
	end
end

endmodule