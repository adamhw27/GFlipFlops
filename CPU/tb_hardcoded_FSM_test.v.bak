`timescale 1ns/1ps

module tb_hardcoded_FSM_test;

  // Testbench signals
  reg clk;
  reg rst;
  wire [15:0] regEnable;
  wire flagEn, RorI;
  wire [7:0] opcode;
  wire [3:0] Rsrc, Rdest;
  wire [15:0] imm;

  // Instantiate DUT (Device Under Test)
  FSM_test2 dut (
    .clk(clk),
    .rst(rst),
    .regEnable(regEnable),
    .flagEn(flagEn),
    .RorI(RorI),
    .opcode(opcode),
    .Rsrc(Rsrc),
    .Rdest(Rdest),
    .imm(imm)
  );

  // Clock generation (100 MHz = 10ns period)
  initial begin
    clk = 0;
    forever #5 clk = ~clk;  // 10ns clock
  end

  // Stimulus
  initial begin
    // Initialize reset
    rst = 1;
    #20;          // Hold reset for 20ns
    rst = 0;

    // Run simulation long enough to reach S7
    #200;

    $display("Simulation finished");
    $stop;
  end

  // Optional: monitor outputs
  initial begin
    $monitor("t=%0t | state outputs: regEnable=%h opcode=%h flagEn=%b Rsrc=%d Rdest=%d imm=%d RorI=%b",
              $time, regEnable, opcode, flagEn, Rsrc, Rdest, imm, RorI);
  end

  // VCD dump for waveform viewing
  initial begin
    $dumpfile("fsm_test2_tb.vcd");
    $dumpvars(0, tb_FSM_test2);
  end

endmodule
