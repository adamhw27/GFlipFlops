`timescale 1ns/1ps

module cpu_ps2_tb;

    // Testbench signals
    reg clk;
    reg rst;
    reg [3:0] key_enc;

    // Instantiate your CPU (update ports if needed)
    cpu UUT (
        .cin(1'b0),
        .clk(clk),
        .rst(rst),
        .key_enc(key_enc),

        // Add other connections here if required
        .AUD_ADCLRCK(),
        .AUD_ADCDAT(),
        .AUD_DACLRCK(),
        .AUD_DACDAT(),
        .AUD_XCK(),
        .AUD_BCLK(),
        .AUD_I2C_SCLK(),
        .AUD_I2C_SDAT()
    );

    // Clock generation: 50MHz → 20ns period
    always begin
        #10 clk = ~clk;
    end

    // Reset sequence
    initial begin
        clk = 0;
        rst = 1;
        #50;
        rst = 0;
    end

    // Your key_enc sequence
    initial begin
        key_enc = 4'b0000;   // starting value

        #20;                 // wait 20 time units
        key_enc = 4'b1011;   // set to 1011

        #20;                 // wait another 20 time units
        key_enc = 4'b0011;   // set to 0011
    end

endmodule
